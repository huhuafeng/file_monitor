# ============================================================
# File Monitor 配置文件示例（模板）
# ============================================================
#
# 使用方式:
#   1. 复制此文件为 file_monitor.conf
#      cp file_monitor.conf.example file_monitor.conf
#   2. 修改 file_monitor.conf 中的配置项
#   3. 运行: bash file_monitor.sh
#
# 安全说明:
#   file_monitor.conf（实际配置文件）已被 .gitignore 排除，
#   不会提交到 git 仓库，请放心填写真实的 Webhook URL 等密钥。
#
# 升级注意事项:
#   升级主脚本时无需修改此配置文件，配置与代码完全分离。
# ============================================================



# ============================================================
# 板块一: 基础配置（必填）
# ============================================================

# ----------------------------------------------------------
# 客户名称
# ----------------------------------------------------------
# 用途: 消息头部 [客户名称] 前缀，当多个客户使用统一接收群时，
#       可通过此前缀快速区分来源。
# 示例:
#   CLIENT_NAME="张三网络科技有限公司"
#   CLIENT_NAME="李四电商平台"
# ----------------------------------------------------------
CLIENT_NAME="请修改为您的客户名称"


# ----------------------------------------------------------
# 通知渠道
# ----------------------------------------------------------
# 可选值:
#   wecom    - 仅发送企业微信
#   feishu   - 仅发送飞书
#   dingtalk - 仅发送钉钉
#   both     - 企业微信和飞书同时发送
#   all      - 企业微信、飞书、钉钉同时发送
# ----------------------------------------------------------
NOTIFY_CHANNEL="wecom"


# ----------------------------------------------------------
# 企业微信机器人 Webhook URL
# ----------------------------------------------------------
# 用途: 企业微信群机器人 Webhook 地址
# 说明: 当 NOTIFY_CHANNEL 为 wecom / both / all 时必须填写
# 获取方式:
#   企业微信群 → 群设置 → 群机器人 → 添加机器人 → 复制 Webhook URL
# 示例:
#   WECOM_WEBHOOK_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
# ----------------------------------------------------------
WECOM_WEBHOOK_URL=""


# ----------------------------------------------------------
# 飞书机器人 Webhook URL
# ----------------------------------------------------------
# 用途: 飞书群机器人 Webhook 地址
# 说明: 当 NOTIFY_CHANNEL 为 feishu / both / all 时必须填写
# 获取方式:
#   飞书群 → 设置 → 群机器人 → 添加机器人 → 复制 Webhook URL
# 示例:
#   FEISHU_WEBHOOK_URL="https://open.feishu.cn/open-apis/bot/v2/hook/aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
# ----------------------------------------------------------
FEISHU_WEBHOOK_URL=""


# ----------------------------------------------------------
# 钉钉机器人 Webhook URL
# ----------------------------------------------------------
# 用途: 钉钉群机器人 Webhook 地址
# 说明: 当 NOTIFY_CHANNEL 为 dingtalk 或 all 时必须填写
# 获取方式:
#   钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 复制 Webhook URL
# 示例:
#   DINGTALK_WEBHOOK_URL="https://oapi.dingtalk.com/robot/send?access_token=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
# ----------------------------------------------------------
DINGTALK_WEBHOOK_URL=""



# ============================================================
# 板块二: 监控配置（必填）
# ============================================================

# ----------------------------------------------------------
# 监控目录
# ----------------------------------------------------------
# 用途: 要监控的目录路径列表，支持多个目录，用空格分隔。
# 说明: 递归监控子目录（可通过 EXCLUDE_DIRS 排除不需要的目录）。
# 示例:
#   WATCH_FOLDERS=("/www/wwwroot/site1" "/www/wwwroot/site2" "/var/www/html")
# ----------------------------------------------------------
WATCH_FOLDERS=(
    "/www/wwwroot/your-site-1"
    "/www/wwwroot/your-site-2"
)


# ----------------------------------------------------------
# 排除目录
# ----------------------------------------------------------
# 用途: 在监控时跳过的目录名，使用正则 OR 格式。
# 说明: 匹配到的目录及其子目录不会被监控，减少不必要的系统开销。
# 示例:
#   EXCLUDE_DIRS="runtime|cache|logs|node_modules|backup|.git|.svn"
# ----------------------------------------------------------
EXCLUDE_DIRS="runtime|cache|logs|node_modules"


# ----------------------------------------------------------
# 监控的文件类型
# ----------------------------------------------------------
# 用途: 仅监控匹配此正则的文件（不区分大小写）。
# 说明:
#   留空 "" 表示监控所有文件。
#   正则语法参考 egrep 扩展正则。
# 示例:
#   WATCH_REGEX='\.php$'                          ← 仅监控 PHP
#   WATCH_REGEX='\.(php|html|js|css)$'            ← 监控多种类型
#   WATCH_REGEX=''                                 ← 监控所有文件
# ----------------------------------------------------------
WATCH_REGEX='\.(php|html|js)$'




# ============================================================
# 板块三: 聚合策略
# ============================================================
# 设计背景:
#   FTP/编辑器上传/部署工具通常会批量传输文件，如果每个文件变动
#   都发送通知会造成消息轰炸。因此设计"聚合窗口"机制：
#   在窗口内收集所有事件，窗口结束后一次性发送摘要。
#
# 双阈值策略:
#   IDLE_TIMEOUT 处理"批量收尾"场景（上传完成后空闲触发）
#   MAX_BATCH_WINDOW 处理"持续事件"场景（防止流式事件无限等待）
#
# 触发示意:
#   事件:  A  B  C  D  E  F  G  H  I  J ...
#   时间:  0  2  4  -  -  -  -  8 10 12 ...
#          ↑                              ↑
#      第一个事件                     第60秒强制发送
#      空闲超时5秒  →  第5秒空闲触发       (如果事件一直持续不停)
# ----------------------------------------------------------

# ----------------------------------------------------------
# 空闲超时（秒）
# ----------------------------------------------------------
# 用途: 无新事件发生后，等待此秒数后发送通知。
# 适用场景: FTP 批量上传完成、编辑器保存完毕，事件流停顿时立即发送。
# 示例:
#   IDLE_TIMEOUT=5     ← 推荐值，上传完成后 5 秒内无新事件则发送
#   IDLE_TIMEOUT=10    ← 保守值，适用于上传文件较多较慢的场景
# ----------------------------------------------------------
IDLE_TIMEOUT=5


# ----------------------------------------------------------
# 最大窗口（秒）
# ----------------------------------------------------------
# 用途: 从第一个事件开始，最多等待此秒数，超时强制发送（不管
#       是否还有新事件）。
# 适用场景: 持续写入日志、动态生成文件等事件流不断的场景，
#           防止通知"永远不会触发"。
# 示例:
#   MAX_BATCH_WINDOW=60    ← 推荐值，最多等 1 分钟
#   MAX_BATCH_WINDOW=120   ← 保守值
# ----------------------------------------------------------
MAX_BATCH_WINDOW=60




# ============================================================
# 板块四: 通知展示设置
# ============================================================

# ----------------------------------------------------------
# 消息中展示的事件条数
# ----------------------------------------------------------
# 用途: 企业微信/飞书/钉钉消息中直接展示的前 N 条事件。
# 说明: 超出此数量的部分不会在消息中显示，但会完整记录到
#       独立日志文件中供后续查阅。
# 示例: DISPLAY_COUNT=5
# ----------------------------------------------------------
DISPLAY_COUNT=5




# ============================================================
# 板块五: 日志配置
# ============================================================

# ----------------------------------------------------------
# 告警日志目录
# ----------------------------------------------------------
# 用途: 每次告警生成的完整事件日志存放目录。
# 说明:
#   - 目录不存在会自动创建（需要写权限）
#   - 日志格式: alert_2026-05-18_10-30-00.log
#   - 日志内容: 包含用户操作时间内的所有事件（不截断）
# 示例: ALERT_LOG_DIR="/var/log/file_monitor"
# ----------------------------------------------------------
ALERT_LOG_DIR="/var/log/file_monitor"


# ----------------------------------------------------------
# 日志保留天数
# ----------------------------------------------------------
# 用途: 自动清理超过此天数的告警日志文件。
# 说明: 设置为 0 表示永不过期（不自动清理）。
# 示例: ALERT_LOG_RETENTION=30
# ----------------------------------------------------------
ALERT_LOG_RETENTION=30
